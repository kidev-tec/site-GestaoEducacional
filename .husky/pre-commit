if [ -z "${BASH_VERSION:-}" ]; then exec bash "$0" "$@"; fi
set -euo pipefail

# Gate local: rápido (<1s). Typecheck/testes ficam no CI (gates.yml).

# 1) Arquivos proibidos no commit
BLOCKED_RE='\.(env|env\.local|env\.production)$|^\.env|^dist/|^coverage/|\.pem$|\.p12$|service-account.*\.json$|^release/(lib|main)\.js$'
BAD=$(git diff --cached --name-only | grep -E "$BLOCKED_RE" || true)
if [ -n "$BAD" ]; then
  echo "❌ commit bloqueado — arquivos proibidos:"
  echo "$BAD"
  exit 1
fi

# 2) Secrets em staged diff
if git diff --cached -U0 | grep -Eiq "(api[_-]?key|secret|password|token)\s*[:=]\s*['\"]?[A-Za-z0-9+/_-]{20,}" \
   && ! git diff --cached -U0 | grep -Eiq "(test|placeholder|example|fixture|mock)"; then
  echo "❌ possível secret no diff staged"
  exit 1
fi

echo "✅ pre-commit ok"
