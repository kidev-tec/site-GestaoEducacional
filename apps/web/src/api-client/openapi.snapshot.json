    "/v1/enrollments": {
      "post": {
        "description": "Cria matrícula idempotente (Idempotency-Key header)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "studentId",
                  "offerId"
                ],
                "properties": {
                  "studentId": {
                    "type": "string"
                  },
                  "offerId": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/enrollments/{id}/transition": {
      "post": {
        "description": "Transiciona estado da matrícula",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "to"
                ],
                "properties": {
                  "to": {
                    "type": "string",
                    "enum": [
                      "DRAFT",
                      "PENDING_DOCUMENTS",
                      "PENDING_APPROVAL",
                      "ACTIVE",
                      "COMPLETED",
                      "CANCELED",
                      "REJECTED"
                    ]
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/enrollments/{id}": {
      "get": {
        "description": "Busca matrícula do tenant",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/ledger/entries": {
      "post": {
        "description": "Lança entrada no ledger (Idempotency-Key header)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "type",
                  "amountCents"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "CHARGE",
                      "PAYMENT",
                      "REVERSAL"
                    ]
                  },
                  "amountCents": {
                    "type": "integer"
                  },
                  "reverses": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/ledger/balance": {
      "get": {
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/audit/count": {
      "get": {
        "responses": {
