# ERP Platform — Web (build estático + nginx)
# Backend API é configurado via VITE_API_BASE_URL no build (args abaixo).
FROM node:22-slim AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/web/package.json ./apps/web/package.json
COPY packages ./packages
RUN npm ci --workspace @erp/web --workspaces --if-present 2>/dev/null || npm ci
COPY apps/web ./apps/web
ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN cd apps/web && ../../node_modules/.bin/vite build --outDir dist

FROM nginx:1.27-alpine
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
# upstream resolvido em runtime (envsubst) — evita race de DNS no boot do compose
RUN printf 'server {\n\
  listen 80;\n\
  root /usr/share/nginx/html;\n\
  index index.html;\n\
  resolver 127.0.0.11 valid=10s ipv6=off;\n\
  location /api/ {\n\
    set $api_upstream api:3000;\n\
    proxy_pass http://$api_upstream/;\n\
    proxy_set_header Host $host;\n\
    proxy_set_header X-Real-IP $remote_addr;\n\
  }\n\
  location / {\n\
    try_files $uri /index.html;\n\
  }\n\
}\n' > /etc/nginx/conf.d/default.conf
EXPOSE 80
