# Caddyfile — ERP Platform (Hostinger)
# Substitua erp.seudominio.com pelo domínio real; Caddy emite TLS sozinho (ACME).
erp.seudominio.com {
	encode zstd gzip
	# API — /api/* → api:3000 (strip do prefixo)
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy api:3000
	}
	# Web (SPA) — todo o resto → nginx do web
	handle {
		reverse_proxy web:80
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}
